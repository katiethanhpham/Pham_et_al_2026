%% 1. Setup
% Specify the folder path (use '.' if the files are in the current folder)
folderPath = uigetdir(pwd, 'Select the PeriNRafter folder');

% Get a list of all .mat files in the folder
fileList = dir(fullfile(folderPath, '*.mat'));

% Initialize the container for the final combined data.
% We create a 1x7 cell array, initially empty.
combinedMeanAll = cell(1, 7);

% Processing
fprintf('Found %d files. Starting combination...\n', length(fileList));

for k = 1:length(fileList)
    % 1. Get the full filename
    thisFileName = fullfile(fileList(k).folder, fileList(k).name);
    
    % 2. Load the .mat file
    % We load it into a structure 'loadedData' to avoid variable name conflicts
    loadedData = load(thisFileName);
    
    % Check if 'Results' exists in this file to prevent errors
    if isfield(loadedData, 'Results')
        
        % Extract the meanAll cell array (1x7)
        currentMeanAll = loadedData.Results.meanAll;
        
        % 3. Loop through each of the 7 cells
        for c = 1:7
            % Vertically concatenate the existing data with the new data.
            % [A; B] puts the rows of B below the rows of A.
            combinedMeanAll{c} = [combinedMeanAll{c}; currentMeanAll{c}];
        end
        
    else
        warning('File %s does not contain the "Results" variable. Skipped.', fileList(k).name);
    end
end

% Finalize
disp('Done!');

% Check the size of the first cell as an example
[totalRows, totalCols] = size(combinedMeanAll{1});
fprintf('Cell 1 combined size: %d rows x %d columns\n', totalRows, totalCols);

% Optional: Save the result to a new file
% save('CombinedResults.mat', 'combinedMeanAll');


%% 2. Filter rsp higher than 8
% Get the number of rows (assuming all cells have the same number of rows)
nRows = size(combinedMeanAll{1}, 1);

% Create a "Logical Mask" to track bad rows. 
% Initially, all are false (0), meaning "Keep this row".
rowsToDelete = false(nRows, 1);

% 2. Identify Bad Rows
fprintf('Checking %d rows across 7 cells...\n', nRows);

for c = 1:7
    currentMatrix = combinedMeanAll{c};
    
    % Check: Is any value in a row > 8?
    % 'currentMatrix > 8' creates a big matrix of 1s and 0s.
    % 'any(..., 2)' collapses columns, returning true if ANY column in that row is true.
    badRowsInThisCell = any(currentMatrix > 8, 2);
    
    % Accumulate the bad rows. 
    % The '|' (OR operator) ensures that if a row is bad in Cell 1 OR Cell 2, 
    % it gets marked for deletion.
    rowsToDelete = rowsToDelete | badRowsInThisCell;
end

% Report how many will be deleted
numDeleted = sum(rowsToDelete);
fprintf('Found %d rows containing values > 8.\n', numDeleted);
fprintf('Remaining rows: %d\n', nRows - numDeleted);

% 3. Apply Deletion
if numDeleted > 0
    for c = 1:7
        % Delete the rows marked as true in 'rowsToDelete'
        combinedMeanAll{c}(rowsToDelete, :) = [];
    end
    disp('Deletion complete. All cells are now synchronized.');
else
    disp('No values over 8 were found. No rows deleted.');
end

%% 3. avg+sem

% Initialize cell arrays to hold the results
% We keep the 1x7 cell structure to match your input data
meanVectors = cell(1, 7);
semVectors  = cell(1, 7);

% Loop through each of the 7 cells
for c = 1:7
    % Extract the big Nx211 matrix for this cell
    thisData = combinedMeanAll{c};
    
    % 1. Compute the Mean
    % mean(data, 1) computes the mean down the columns (collapsing rows)
    % Result is a 1x211 vector
    meanVectors{c} = mean(thisData, 1);
    
    % 2. Compute the Standard Error of the Mean (SEM)
    % SEM = Standard Deviation / sqrt(N)
    % N is the number of rows (observations)
    N = size(thisData, 1);
    
    % std(data, 0, 1):
    % The '0' specifies normalizing by N-1 (standard unbiased estimator)
    % The '1' specifies operating along the first dimension (columns)
    stdDev = std(thisData, 0, 1);
    
    semVectors{c} = stdDev ./ sqrt(N);
end

% This creates a 7x211 matrix where row 1 is Cell 1's mean, etc.
meanMatrix = vertcat(meanVectors{:});
semMatrix = vertcat(semVectors{:});


